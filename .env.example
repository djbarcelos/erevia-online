# Copie para .env (que não vai para o git) e preencha. O Makefile carrega este arquivo.

# Login com Google: console.cloud.google.com → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web)
# URL de redirecionamento autorizada (dev): http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login com Discord: discord.com/developers/applications → OAuth2
# Redirect (dev): http://localhost:5173/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Endereço público usado nas URLs de retorno do OAuth (dev = Vite)
PUBLIC_URL=http://localhost:5173

# Login sem senha para desenvolvimento. NUNCA ative em produção.
DEV_LOGIN=true

# Alertas no Discord (opcional; vazio = só no log). Canal → Configurações → Integrações → Webhooks.
# A URL é segredo: só aqui no .env (local) ou na variável da Railway.
ALERT_WEBHOOK_URL=
