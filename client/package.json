{
  "name": "erevia-client",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-ktx2-decoder.mjs",
    "dev": "vite",
    "build": "node scripts/build-changelog.mjs && node scripts/build-ktx2-decoder.mjs && tsc --noEmit && vite build",
    "changelog": "node scripts/build-changelog.mjs",
    "changelog:draft": "node scripts/changelog-draft.mjs",
    "typecheck": "tsc --noEmit",
    "check:assets": "node scripts/check-assets.mjs",
    "test:assets": "node --test \"tests/assets/*.test.mjs\"",
    "test:unit": "node --test \"tests/*.test.ts\" \"tests/assets/*.test.mjs\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@babylonjs/core": "^9.36.0",
    "@babylonjs/gui": "^9.36.0",
    "@babylonjs/loaders": "^9.36.0",
    "@babylonjs/materials": "^9.36.0",
    "@bufbuild/protobuf": "^2.17.0",
    "@fontsource/cinzel": "^5.3.0"
  },
  "devDependencies": {
    "@babylonjs/ktx2decoder": "^9.36.0",
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "jpeg-js": "^0.4.4",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
